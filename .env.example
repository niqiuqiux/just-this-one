# Supabase Project Settings → API. Both values are public browser configuration.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the publishable key (sb_publishable_...) or legacy anon key, NEVER service_role.
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Pages uses the included /api/supabase proxy; Vite forwards the same path locally.
VITE_SUPABASE_PROXY=true
